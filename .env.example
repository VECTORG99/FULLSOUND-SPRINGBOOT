# ============================================================
# FULLSOUND - Variables de entorno para Docker Compose
# ============================================================
# Copia este archivo a .env y ajusta los valores según tu entorno.
#   cp .env.example .env
# ============================================================

# ==================== POSTGRESQL ====================
POSTGRES_DB=fullsound
POSTGRES_USER=fullsound
POSTGRES_PASSWORD=fullsound_secret

# ==================== JWT ====================
# Debe ser una clave de 512+ bits para HS512 en producción
JWT_SECRET=myDefaultJwtSecretKeyForDevelopmentOnlyPleaseChangeInProduction1234567890
JWT_EXPIRATION=86400000

# ==================== STRIPE ====================
STRIPE_API_KEY=sk_test_disabled
STRIPE_WEBHOOK_SECRET=whsec_disabled

# ==================== CORS ====================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
